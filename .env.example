# ============================================================================
# ARCHÉ — variáveis de ambiente
# Sem NENHUMA destas variáveis, o sistema roda em MODO LOCAL:
#   persistência em data/estado.json e arquivos em data/uploads/.
# Preencha só o bloco do backend que você for usar em produção.
# ============================================================================

NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------------------
# PERSISTÊNCIA — MySQL/MariaDB (opcional; se vazio, usa arquivo local)
# Crie a tabela com schema.sql. Ex.: mysql://usuario:senha@127.0.0.1:3306/arche
# ---------------------------------------------------------------------------
# DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO

# ---------------------------------------------------------------------------
# ARQUIVOS — GOOGLE DRIVE via OAuth (para Gmail PESSOAL) — RECOMENDADO p/ Jadson
# Os arquivos ficam no SEU Drive, contando na sua cota.
# 1. Console Google Cloud > crie um projeto > ative a "Google Drive API".
# 2. Tela de consentimento OAuth: tipo "Externo", adicione seu Gmail como
#    usuário de teste e PUBLIQUE o app (evita o token expirar em 7 dias).
# 3. Credenciais > Criar > ID do cliente OAuth > tipo "App para computador".
#    Copie Client ID e Client Secret para as duas variáveis abaixo.
# 4. Rode:  node scripts/gdrive-auth.mjs   (autoriza uma vez; grava o token)
# 5. (Opcional) GDRIVE_FOLDER_ID: se vazio, cria a pasta "ARCHÉ" no seu Drive.
# ---------------------------------------------------------------------------
# GDRIVE_OAUTH_CLIENT_ID=
# GDRIVE_OAUTH_CLIENT_SECRET=
# GDRIVE_OAUTH_REFRESH_TOKEN=      (preenchido pelo script de autorização)
# GDRIVE_FOLDER_NAME=ARCHÉ
# GDRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# ARQUIVOS — GOOGLE DRIVE via CONTA DE SERVIÇO (só Workspace / Drive Compartilhado)
# Não funciona em Gmail pessoal (conta de serviço não tem cota).
# ---------------------------------------------------------------------------
# GDRIVE_FOLDER_ID=ID_DA_PASTA_COMPARTILHADA
# GDRIVE_KEY_FILE=./credenciais/conta-servico.json
# GDRIVE_KEY_JSON=

# ---------------------------------------------------------------------------
# ARQUIVOS — S3 (alternativa: AWS S3, MinIO, Wasabi...)
# Só é usado se GDRIVE_FOLDER_ID estiver vazio.
# ---------------------------------------------------------------------------
# S3_REGION=us-east-1
# S3_BUCKET=arche-comprovantes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
